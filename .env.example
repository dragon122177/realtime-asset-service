NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://forgeflow:forgeflow@localhost:5432/forgeflow
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
LIVE_TICKET_TTL_SECONDS=60

STORAGE_DRIVER=filesystem
STORAGE_ROOT=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=forgeflow-assets
S3_ACCESS_KEY=forgeflow
S3_SECRET_KEY=replace-with-a-random-secret
S3_USE_SSL=false

MAX_UPLOAD_BYTES=52428800
WORKER_POLL_MS=1000
WORKER_METRICS_PORT=9092
WORKER_MAX_ATTEMPTS=4
PROCESSOR_VERSION=forgeflow-analyzer-1.0.0

VITE_API_URL=http://localhost:8080

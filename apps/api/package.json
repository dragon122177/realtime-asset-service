{
  "name": "@forgeflow/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsup",
    "db:migrate": "tsx src/commands/migrate.ts",
    "db:seed": "tsx src/commands/seed.ts",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
